# Build artifacts
build/

# Compiled objects / binaries
*.o
*.elf
*.bin
*.hex
*.map
*.lst

# Editor / IDE
.vscode/*.db
.vscode/*.log

# Python
__pycache__/
*.pyc

# outputs
outputs/*.csv
outputs/*.png

# 采集残留/未分段的散落扫描（从 datasets/ 移出，仅本地保留）
outputs/scan_leftovers/
outputs/train_log*.txt

# datasets
mnist/
print/

# matplotlib cache (created by train_digit.py via MPLCONFIGDIR)
outputs/.mplcache/
outputs/vendor/

# ST Edge AI 验证/日志产物（可重新生成）
outputs/st_ai_*/
outputs/AIStudio_Logs/
outputs/STM32G0B1_TEST_run-2_logs.txt

# 调试器会话残留
:memory:.ses

# ST Edge AI 生成的信息文件（buffer 布局等，可重新生成）
.ai/
